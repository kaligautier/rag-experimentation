# ADK Agent Template - Environment Variables
# Copy this file to .env and fill in your values

# =============================================================================
# Required Configuration
# =============================================================================

# Google Cloud Platform (required for Vertex AI)
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-gcp-project
GOOGLE_CLOUD_LOCATION=global

# Local gcloud account used to obtain Application Default Credentials:
#   gcloud config set account user@example.com
#   gcloud auth application-default login

# =============================================================================
# Optional Configuration (with defaults)
# =============================================================================

# Application Settings
APP_NAME="ADK Agent Template"
APP_DESCRIPTION="Production-ready ADK agent template"
APP_VERSION="0.1.0"
PROJECT_NAME="adk-agent-template"

# Server Configuration
HOST=0.0.0.0
PORT=7777
DEBUG=false

# Logging
LOG_LEVEL=INFO

# Agent Configuration
AGENT_NAME=template_agent
MODEL=gemini-3.8-flash

# Session Management
USER_ID=api_user

# Start local DB: docker compose up -d postgres (dedicated port, avoids Homebrew)
RAG_DB_URL=postgresql+asyncpg://rag_user:secret@127.0.0.1:15433/rag_db
RAG_DB_POOL_SIZE=20
RAG_DB_MAX_OVERFLOW=10

RAG_EMBEDDING_MODEL=gemini-embedding-001
RAG_EMBEDDING_DIMENSIONS=3072
RAG_EMBEDDING_LOCATION=europe-west1
RAG_EMBEDDING_BATCH_SIZE=5

# Text Chunking
RAG_CHUNK_SIZE=1200
RAG_CHUNK_OVERLAP=200
RAG_MIN_CHUNK_SIZE=200
RAG_MAX_CHUNKS_PER_DOC=2000

# Document Search/Retrieval
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.6
RAG_MAX_UPLOAD_BYTES=5242880

# Storage (local filesystem or GCS)
RAG_STORAGE_TYPE=local
RAG_STORAGE_PATH=/tmp/rag_storage
# RAG_STORAGE_BUCKET_NAME=your-gcs-bucket  # For cloud storage
